# Environment variables — copy to .env.local and fill in values.
# Never commit .env.local to version control.

# Cloudflare Worker API URL (no trailing slash)
VITE_API_BASE_URL=https://myhomesolar-api.solarsmart-energies.workers.dev

# Contact form email (formsubmit.co recipient)
# Do NOT commit the real address — set it in Vercel project environment variables.
VITE_CONTACT_EMAIL=your-email@example.com
